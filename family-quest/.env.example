# Supabase 프로젝트 설정. 실제 값은 .env.local 에만 기록하고 커밋하지 않는다.
# 둘 다 비어 있으면 앱은 "데모 모드"(브라우저 메모리, 저장 안 됨)로 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 웹 푸시 알림 (설정 화면에서 켜면 아침 8시·저녁 8시에 알림). 비워 두면 알림 기능이 꺼진다.
# 키 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 발송 API(/api/push/send) 를 부르는 쪽(Supabase pg_cron)과 공유하는 비밀값. DB private.push_config 에도 같은 값
PUSH_SECRET=
